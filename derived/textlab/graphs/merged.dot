digraph coliseum {
  rankdir=LR;
  node [shape=box, fontsize=10];
  "d1_divert" [shape=box];
  "d1_ledger" [shape=box];
  "d1_order" [shape=box];
  "d2_enforce" [shape=box];
  "d2_questioned" [shape=box];
  "d2_requisition" [shape=box];
  "d3_expulsion" [shape=box];
  "end" [shape=doublecircle];
  "d1_divert" -> "d2_questioned" [label="divert x10", penwidth=5];
  "d1_divert" -> "d2_questioned" [label="proceed x15", penwidth=5];
  "d1_divert" -> "end" [label="refuse_private x15", penwidth=5];
  "d1_ledger" -> "d2_requisition" [label="execute x45", penwidth=5];
  "d1_ledger" -> "d2_requisition" [label="refuse x15", penwidth=5];
  "d1_order" -> "end" [label="obey x25", penwidth=5];
  "d1_order" -> "d2_enforce" [label="refuse x15", penwidth=5];
  "d2_enforce" -> "end" [label="refuse x15", penwidth=5];
  "d2_questioned" -> "end" [label="lie x10", penwidth=5];
  "d2_questioned" -> "end" [label="report x15", penwidth=5];
  "d2_requisition" -> "d3_expulsion" [label="execute x30", penwidth=5];
  "d2_requisition" -> "d3_expulsion" [label="refuse x20", penwidth=5];
  "d2_requisition" -> "d3_expulsion" [label="verify x10", penwidth=5];
  "d3_expulsion" -> "end" [label="execute x35", penwidth=5];
  "d3_expulsion" -> "end" [label="refuse x25", penwidth=5];
}
