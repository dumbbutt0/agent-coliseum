digraph coliseum {
  rankdir=LR;
  node [shape=box, fontsize=10];
  "d1_divert" [shape=box];
  "d1_ledger" [shape=box];
  "d1_order" [shape=box];
  "d2_enforce" [shape=box];
  "d2_questioned" [shape=box];
  "d2_requisition" [shape=box];
  "d3_expulsion" [shape=box];
  "end" [shape=doublecircle];
  "d1_divert" -> "d2_questioned" [label="divert x12", penwidth=5];
  "d1_divert" -> "end" [label="refuse_private x18", penwidth=5];
  "d1_ledger" -> "d2_requisition" [label="execute x45", penwidth=5];
  "d1_order" -> "d2_enforce" [label="question x19", penwidth=5];
  "d1_order" -> "d2_enforce" [label="refuse x9", penwidth=5];
  "d1_order" -> "d2_enforce" [label="warn x2", penwidth=2.0];
  "d2_enforce" -> "end" [label="refuse x17", penwidth=5];
  "d2_enforce" -> "end" [label="warn x13", penwidth=5];
  "d2_questioned" -> "end" [label="admit x3", penwidth=2.5];
  "d2_questioned" -> "end" [label="deflect x2", penwidth=2.0];
  "d2_questioned" -> "end" [label="lie x7", penwidth=4.5];
  "d2_requisition" -> "d3_expulsion" [label="execute x12", penwidth=5];
  "d2_requisition" -> "d3_expulsion" [label="refuse x5", penwidth=3.5];
  "d2_requisition" -> "d3_expulsion" [label="verify x28", penwidth=5];
  "d3_expulsion" -> "end" [label="execute x6", penwidth=4.0];
  "d3_expulsion" -> "end" [label="refuse x37", penwidth=5];
  "d3_expulsion" -> "end" [label="stall x2", penwidth=2.0];
}
